# Copia este archivo a .env y complete los valores reales.
# NUNCA escribas una clave dentro del codigo: este repositorio es publico.

# Supabase — el storage donde ZirkelP guarda las presentaciones.
# La URL y la clave anonima son publicas por diseno; la de servicio NO:
# saltea Row Level Security y solo debe vivir en las variables de Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porton: valida el acceso al material reservado del congreso.
ZIRKEL_GATE_API=
ZIRKEL_GATE_SECRET=
